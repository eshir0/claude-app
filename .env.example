# Copy this file to .env for local dev, and provide the same variables to
# docker-compose (via a .env next to docker-compose.yml) for deployment.
# None of these have safe defaults — the app refuses to start without them.

# SQLite file path. Local dev: file:./prisma/dev.db
# Docker (see docker-compose.yml): file:/data/prod.db
DATABASE_URL=file:./prisma/dev.db

# bcrypt hash of your login password. Generate with:
#   node scripts/hash-password.mjs
# (interactive prompt — never pass the password as a CLI argument)
#
# IMPORTANT: Next.js expands "$VARIABLE" in .env files to reference other
# variables. A bcrypt hash ($2b$12$...) will be silently mangled unless every
# "$" is escaped as "\$" — e.g. AUTH_PASSWORD_HASH=\$2b\$12\$restOfTheHash...
# (the hash-password script's output already reminds you of this).
AUTH_PASSWORD_HASH=

# Random secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Random key used to encrypt saved provider login sessions at rest (the
# automated-collector "connections" feature — see README "자동 수집 연결").
# Generate the SAME way as SESSION_SECRET, but use a different value —
# never reuse one secret for two purposes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key permanently locks you out of any already-saved sessions
# (by design — there is no recovery path). Rotating it requires
# reconnecting every provider.
CREDENTIAL_ENCRYPTION_KEY=

# Path to the official `codex` CLI binary, used only to run its
# `login --device-auth` flow on your behalf (never to make API calls
# itself). Defaults to node_modules/.bin/codex (it's a real dependency in
# package.json — see @openai/codex). Only set this if you need a different
# binary, e.g. a system-wide install.
# CODEX_CLI_PATH=/path/to/codex

# The exact origin(s) this app is served from, used to reject cross-origin
# state-changing requests (login/logout/create/delete). Must match what
# users actually type in the browser, including scheme and port. Comma-
# separate multiple origins if the same server is reachable more than one
# way (e.g. a LAN IP and a port-forwarded public IP):
#   APP_ORIGIN=http://192.168.1.179:3000,http://203.0.113.5:3000
# Local dev: http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Only set to "true" if this app sits behind a reverse proxy that you
# control and that OVERWRITES (not appends to) the client-IP header before
# forwarding to this app. See README "Login rate limiting" section before
# enabling this — it changes which header the app trusts for login
# rate-limiting.
# TRUSTED_PROXY=false
# CLIENT_IP_HEADER=X-Forwarded-For

# Proxmox VE integration (server monitor module) — all four required for
# that module to work; the app runs fine without them, the module just
# shows "not configured" instead.
#   PROXMOX_URL: the Proxmox web UI origin, e.g. https://192.168.1.x:8006
#   PROXMOX_TOKEN_ID: "<user>@<realm>!<tokenid>", e.g. root@pam!dashboard
#   PROXMOX_TOKEN_SECRET: the token's Secret, shown once when you create it
#     in Proxmox (Datacenter > Permissions > API Tokens > Add)
#   PROXMOX_SSL_FINGERPRINT: the node's own TLS cert fingerprint, from
#     `GET {PROXMOX_URL}/api2/json/nodes` (field `ssl_fingerprint`) — pinned
#     instead of normal CA verification, since Proxmox's cert is
#     self-signed by default. Colons optional, case-insensitive.
# PROXMOX_URL=https://192.168.1.x:8006
# PROXMOX_TOKEN_ID=root@pam!dashboard
# PROXMOX_TOKEN_SECRET=
# PROXMOX_SSL_FINGERPRINT=

# DANGEROUS — leave unset for any real deployment. Only for testing a
# production build over plain HTTP on a LAN IP or other non-"localhost"
# hostname, where browsers do NOT treat the connection as a secure context
# and silently drop the session cookie (login appears to just do nothing).
# Setting this to "true" turns off the cookie's Secure flag entirely.
# FORCE_INSECURE_COOKIES=true
