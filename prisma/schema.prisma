datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

enum EntrySource {
  MANUAL
  AUTO
}

model AiUsageEntry {
  id           String      @id @default(cuid())
  // Matches an id in src/modules/ai-usage/metrics.ts (USAGE_METRICS).
  // Validated at the application layer (zod), not a DB enum, so adding a
  // metric never requires a migration.
  metricId     String
  // 0-100, "percent used" (never "percent remaining"). A point-in-time
  // observation, not a cumulative counter — never summed/diffed.
  usagePercent Float
  // No @db.VarChar — SQLite has no variable-length string constraint. The
  // 500-char cap is enforced in shared zod validation (logic.ts).
  note         String?
  source       EntrySource @default(MANUAL)
  // When the value was actually observed in the service's own UI (UTC).
  recordedAt   DateTime
  // When this limit period resets, if known (UTC). Null when unknown.
  resetsAt     DateTime?
  // When this row was saved to this app (UTC) — distinct from recordedAt.
  createdAt    DateTime    @default(now())

  @@index([metricId, recordedAt])
}

enum ConnectionProvider {
  OPENAI
}

enum ConnectionStatus {
  CONNECTED
  ERROR
}

// A saved, encrypted OAuth credential (access_token + refresh_token + expiry)
// for one provider, obtained via the provider's own official device-code
// login flow — never a scraped browser session. One row per provider; this
// is a single-user app so there is never more than one live connection per
// service. `encryptedState` holds an AES-256-GCM-encrypted JSON blob of the
// token set — never stored or logged in plaintext. Losing
// CREDENTIAL_ENCRYPTION_KEY makes existing rows permanently undecryptable by
// design (no key-recovery backdoor).
model ServiceConnection {
  id             String             @id @default(cuid())
  provider       ConnectionProvider @unique
  encryptedState String
  status         ConnectionStatus   @default(CONNECTED)
  lastError      String?
  lastCheckedAt  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

// One real historical Lotto 6/45 draw, scraped from superkts.com. A local
// cache — not the source of truth — so the combo generator's frequency
// groups / co-occurrence counts / exact-match check don't require
// re-scraping the whole history on every run. No array type in SQLite, so
// the 6 main numbers are 6 plain columns rather than a JSON/CSV blob.
model LottoDraw {
  id        String   @id @default(cuid())
  round     Int      @unique
  n1        Int
  n2        Int
  n3        Int
  n4        Int
  n5        Int
  n6        Int
  bonus     Int
  fetchedAt DateTime @default(now())
}

// A set of 5 generated combinations, computed once for a given round (the
// most recent round known at generation time). `forRound` being unique is
// what makes weekly regeneration idempotent — the background scheduler
// checks for new rounds far more often than once a week, but this
// constraint guarantees at most one generated set per round no matter how
// many times the check runs.
model LottoComboSet {
  id              String   @id @default(cuid())
  forRound        Int      @unique
  // JSON-stringified LottoComboAnnotation[] (see src/modules/lotto/types.ts)
  // — validated at the application layer (zod) on read, same reasoning as
  // AiUsageEntry.metricId not being a DB enum.
  combosJson      String
  randomPickIndex Int
  generatedAt     DateTime @default(now())
}

// One reported HTTP request, from this app or any other self-hosted server
// running the same scripts/ip-log-agent.mjs in front of itself. `source` is
// a caller-asserted label bound to a per-source credential at the ingest
// API (see AGENTS/README "접속 기록"), not a cryptographic identity of the
// request itself. `ip` is always canonicalized before storage (IPv4-mapped
// IPv6 collapsed to IPv4, IPv6 in RFC-5952-equivalent canonical form) so the
// same real client never splits across two textual representations. `path`
// is the request's pathname ONLY — the query string is never read into
// this app at all, let alone stored, since it can carry tokens/secrets.
// `at` is always this server's own clock at ingestion time, never a
// client-supplied timestamp (see collector/collectService.ts).
model AccessLogEntry {
  id        String   @id @default(cuid())
  source    String
  ip        String
  method    String
  path      String
  userAgent String?
  at        DateTime @default(now())

  @@index([ip, at])
  @@index([source, at])
  @@index([at])
}

enum GeoLookupStatus {
  // country/city populated (city may still be null if the provider lacked it)
  RESOLVED
  // not a globally routable public-unicast address eligible for lookup
  // (see isGeoIpEligiblePublicAddress in modules/access-log/logic.ts) —
  // permanent, never retried.
  NOT_APPLICABLE
  // transient provider/network error — retried after a backoff window.
  FAILED
}

// One row per distinct IP ever seen in AccessLogEntry, decoupled from the
// log rows themselves so a resolved location survives log retention pruning
// independently — except that this row itself is deleted once no
// AccessLogEntry references its ip anymore (see collector/collectService.ts
// "orphan cleanup"), so this table never grows unbounded either.
// `lastCheckedAt` is the last time this row was written OR attempted,
// regardless of status — deliberately not named "resolvedAt", since a
// FAILED row was never resolved.
model IpGeoCache {
  ip            String          @id
  status        GeoLookupStatus
  country       String?
  city          String?
  lastCheckedAt DateTime        @default(now())
}
