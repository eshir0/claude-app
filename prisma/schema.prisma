datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

enum EntrySource {
  MANUAL
  AUTO
}

model AiUsageEntry {
  id           String      @id @default(cuid())
  // Matches an id in src/modules/ai-usage/metrics.ts (USAGE_METRICS).
  // Validated at the application layer (zod), not a DB enum, so adding a
  // metric never requires a migration.
  metricId     String
  // 0-100, "percent used" (never "percent remaining"). A point-in-time
  // observation, not a cumulative counter — never summed/diffed.
  usagePercent Float
  // No @db.VarChar — SQLite has no variable-length string constraint. The
  // 500-char cap is enforced in shared zod validation (logic.ts).
  note         String?
  source       EntrySource @default(MANUAL)
  // When the value was actually observed in the service's own UI (UTC).
  recordedAt   DateTime
  // When this limit period resets, if known (UTC). Null when unknown.
  resetsAt     DateTime?
  // When this row was saved to this app (UTC) — distinct from recordedAt.
  createdAt    DateTime    @default(now())

  @@index([metricId, recordedAt])
}

enum ConnectionProvider {
  OPENAI
}

enum ConnectionStatus {
  CONNECTED
  ERROR
}

// A saved, encrypted OAuth credential (access_token + refresh_token + expiry)
// for one provider, obtained via the provider's own official device-code
// login flow — never a scraped browser session. One row per provider; this
// is a single-user app so there is never more than one live connection per
// service. `encryptedState` holds an AES-256-GCM-encrypted JSON blob of the
// token set — never stored or logged in plaintext. Losing
// CREDENTIAL_ENCRYPTION_KEY makes existing rows permanently undecryptable by
// design (no key-recovery backdoor).
model ServiceConnection {
  id             String             @id @default(cuid())
  provider       ConnectionProvider @unique
  encryptedState String
  status         ConnectionStatus   @default(CONNECTED)
  lastError      String?
  lastCheckedAt  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

// One real historical Lotto 6/45 draw, scraped from superkts.com. A local
// cache — not the source of truth — so the combo generator's frequency
// groups / co-occurrence counts / exact-match check don't require
// re-scraping the whole history on every run. No array type in SQLite, so
// the 6 main numbers are 6 plain columns rather than a JSON/CSV blob.
model LottoDraw {
  id        String   @id @default(cuid())
  round     Int      @unique
  n1        Int
  n2        Int
  n3        Int
  n4        Int
  n5        Int
  n6        Int
  bonus     Int
  fetchedAt DateTime @default(now())
}

// A set of 5 generated combinations, computed once for a given round (the
// most recent round known at generation time). `forRound` being unique is
// what makes weekly regeneration idempotent — the background scheduler
// checks for new rounds far more often than once a week, but this
// constraint guarantees at most one generated set per round no matter how
// many times the check runs.
model LottoComboSet {
  id              String   @id @default(cuid())
  forRound        Int      @unique
  // JSON-stringified LottoComboAnnotation[] (see src/modules/lotto/types.ts)
  // — validated at the application layer (zod) on read, same reasoning as
  // AiUsageEntry.metricId not being a DB enum.
  combosJson      String
  randomPickIndex Int
  generatedAt     DateTime @default(now())
}
